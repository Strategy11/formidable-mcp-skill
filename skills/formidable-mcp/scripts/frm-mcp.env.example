# frm-mcp.env.example — template for the local, machine-specific config the
# frm-mcp helper reads.
#
# Easiest: skip this template. WP Admin -> Formidable -> Settings -> MCP ->
# "Download frm-mcp.env" creates a password scoped to Formidable MCP and gives
# you the finished file. Move it beside the installed frm-mcp helper as frm-mcp.env.
#
# Otherwise copy this template there and fill in your own values:
#
#   cp frm-mcp.env.example frm-mcp.env
#   chmod 600 frm-mcp.env
#
# After a plugin update, keep frm-mcp.env beside the current helper.
#
# frm-mcp.env is gitignored and must never be committed. Fill it in yourself in
# an editor — there is no reason to paste these values into a chat with an AI
# assistant, and an assistant should never ask you to.
#
# APPLICATION_PASSWORD is a WordPress *application password* (WP Admin →
# Users → Profile → Application Passwords) for an administrator — not the
# account password. Spaces in it are fine; keep the quotes.

SITE_URL="https://your-site.local"
WP_USERNAME="admin"
APPLICATION_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Optional. For a local site with a self-signed certificate, prefer trusting the
# environment's CA (Local by Flywheel's "Trust" button, `valet trust`,
# `mkcert -install`). Failing that, point at the CA file:
# FRM_MCP_CACERT="/path/to/local-ca.pem"
