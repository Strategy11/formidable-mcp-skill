#!/bin/bash
# frm-mcp — call a Formidable MCP ability over the HTTP transport with a
# human-readable body. Handles session init, expiry, and retry automatically.
#
# Usage:
#   frm-mcp <ability-name> '<json-body>'      # pretty-printed JSON, shown as-is in permission prompts
#   frm-mcp <ability-name> '<yaml-body>'      # YAML also accepted (JSON is tried first)
#   frm-mcp <ability-name>                    # empty parameters
#
# Examples:
#   frm-mcp formidable-forms/list-forms
#   frm-mcp formidable-forms/create-entry '{"form_id": "123", "456": "value"}'
#
# Configuration comes from env vars SITE_URL, WP_USERNAME, APPLICATION_PASSWORD,
# falling back to a frm-mcp.env file next to this script — so secrets never
# appear on the command line or in permission prompts. frm-mcp.env is
# machine-specific: create it locally and never commit it. Example:
#   SITE_URL="https://your-site.local"
#   WP_USERNAME="admin"
#   APPLICATION_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
#
# TLS is verified by default. For a local site with a self-signed certificate,
# prefer trusting the environment's CA (Local by Flywheel's "Trust" button,
# `valet trust`, `mkcert -install`), or set FRM_MCP_CACERT to the CA file.
# FRM_MCP_INSECURE=1 disables verification outright — local use only.
#
# Dependencies: curl, jq. Ruby (stock on macOS) is used only for YAML bodies.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"

# frm-mcp.env supplies defaults; real environment variables win. Sourcing the
# file plainly would let it clobber an explicit `SITE_URL=... frm-mcp ...`,
# which silently sends credentials to whichever host the file names.
_env_site_url="${SITE_URL:-}"
_env_wp_username="${WP_USERNAME:-}"
_env_application_password="${APPLICATION_PASSWORD:-}"
[ -f "$DIR/frm-mcp.env" ] && . "$DIR/frm-mcp.env"
[ -n "$_env_site_url" ] && SITE_URL="$_env_site_url"
[ -n "$_env_wp_username" ] && WP_USERNAME="$_env_wp_username"
[ -n "$_env_application_password" ] && APPLICATION_PASSWORD="$_env_application_password"

: "${SITE_URL:?Set SITE_URL (env or frm-mcp.env)}"
: "${WP_USERNAME:?Set WP_USERNAME (env or frm-mcp.env)}"
: "${APPLICATION_PASSWORD:?Set APPLICATION_PASSWORD (env or frm-mcp.env)}"

URL="${SITE_URL%/}/wp-json/mcp/formidable-mcp"
AUTH="$WP_USERNAME:$APPLICATION_PASSWORD"
SESSION_FILE="$DIR/.mcp-session"

# Build the TLS options curl runs with. Expanded as ${TLS_OPTS[@]+"${TLS_OPTS[@]}"}
# below — under `set -u`, bash 3.2 (stock on macOS) treats a bare "${arr[@]}" on an
# empty array as an unbound variable.
TLS_OPTS=()
if [ -n "${FRM_MCP_CACERT:-}" ]; then
  TLS_OPTS+=(--cacert "$FRM_MCP_CACERT")
elif [ "${FRM_MCP_INSECURE:-0}" = "1" ]; then
  case "$URL" in
    https://*.local/*|https://*.test/*|https://localhost*|https://127.0.0.1*)
      TLS_OPTS+=(-k) ;;
    *)
      echo "frm-mcp: refusing FRM_MCP_INSECURE=1 for a non-local host ($SITE_URL)." >&2
      echo "         Trust the site's CA or set FRM_MCP_CACERT instead." >&2
      exit 1 ;;
  esac
fi

ability="$1"
body_arg="${2:-}"

# Body: pretty JSON preferred (validated/compacted by jq); YAML fallback via ruby
if [ -n "$body_arg" ]; then
  if ! params=$(printf '%s' "$body_arg" | jq -c '.' 2>/dev/null); then
    params=$(printf '%s' "$body_arg" | ruby -ryaml -rjson -e 'puts JSON.generate(YAML.safe_load(STDIN.read) || {})')
  fi
else
  params='{}'
fi

init_session() {
  curl -s -i ${TLS_OPTS[@]+"${TLS_OPTS[@]}"} -X POST "$URL" \
    -H "Content-Type: application/json" \
    -u "$AUTH" \
    -d '{"jsonrpc":"2.0","method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"claude","version":"1.0"}},"id":1}' \
    2>/dev/null | grep -i "mcp-session-id" | head -1 | cut -d' ' -f2 | tr -d '\r' > "$SESSION_FILE"
}

call() {
  local body
  body=$(jq -n --arg a "$ability" --argjson p "$params" \
    '{jsonrpc:"2.0",method:"tools/call",params:{name:"mcp-adapter-execute-ability",arguments:{ability_name:$a,parameters:$p}},id:2}')
  # Keep curl's stderr: a TLS or DNS failure returns no body, and silently
  # printing nothing reads like an empty result rather than a broken connection.
  curl -sS ${TLS_OPTS[@]+"${TLS_OPTS[@]}"} -X POST "$URL" \
    -H "Content-Type: application/json" \
    -H "Mcp-Session-Id: $(cat "$SESSION_FILE" 2>/dev/null || true)" \
    -u "$AUTH" -d "$body"
}

out=$(call)
if echo "$out" | grep -qiE 'session not found|Missing Mcp-Session-Id|Invalid or expired'; then
  init_session
  out=$(call)
fi
if [ -z "$out" ]; then
  echo "frm-mcp: no response from $URL (see the curl error above)." >&2
  echo "         A certificate error here means TLS is working as intended —" >&2
  echo "         trust the site's CA or set FRM_MCP_CACERT rather than FRM_MCP_INSECURE." >&2
  exit 1
fi
# NOTE the parentheses close BEFORE the final `// .result` — binding the
# alternative inside the pipe makes non-JSON error text crash jq instead of
# printing the error envelope.
echo "$out" | jq '.result.structuredContent // (.result.content[0].text | fromjson?) // .result'
